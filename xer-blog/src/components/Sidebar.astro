---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
type SidebarEntry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const flattenArticleFolders = (entries: SidebarEntry[]) =>
	entries.flatMap((entry) =>
		entry.type === 'group' ? flattenArticleFolders(entry.entries) : [entry],
	);

const acronyms = new Set(['dd', 'ss', 'ff', 'fs', 'sf', 'cp', 'cpm', 'p6']);

const friendlyMetricLabel = (label: string) => {
	const words = label.replace(/^\d+_/, '').split('_');
	return words
		.map((word, index) => {
			const normalized = word.toLowerCase();
			if (acronyms.has(normalized)) return normalized.toUpperCase();
			return index === 0
				? normalized.charAt(0).toUpperCase() + normalized.slice(1)
				: normalized;
		})
		.join(' ');
};

const labelMetricFolders = (entries: SidebarEntry[]): SidebarEntry[] =>
	entries.map((entry) =>
		entry.type === 'group'
			? { ...entry, label: friendlyMetricLabel(entry.label), entries: labelMetricFolders(entry.entries) }
			: entry,
	);

const sidebar = Astro.locals.starlightRoute.sidebar.map((entry, index) =>
	index === 0 && entry.type === 'group'
		? { ...entry, entries: flattenArticleFolders(entry.entries) }
		: index === 1 && entry.type === 'group'
			? { ...entry, entries: labelMetricFolders(entry.entries) }
			: entry,
);
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
