{
  "name": "xer-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:blog": "pnpm --filter xer-blog dev",
    "build:blog": "pnpm --filter xer-blog build",
    "dev:landing": "pnpm --filter xer-landing dev",
    "build:landing": "pnpm --filter xer-landing build",
    "dev:docs": "pnpm --filter xer-docs dev",
    "build:docs": "pnpm --filter xer-docs build",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "wrangler": "^4.146.0"
  }
}
